# Phone pairing (public HTTPS page companion)
# The static /phone UI can fall back to PeerJS cloud; override these if you run your own server.
VITE_PEERJS_HOST=0.peerjs.com
VITE_PEERJS_PORT=443
VITE_PEERJS_PATH=/

# Optional AI provider defaults (do not commit real keys)
VITE_AI_PROVIDER=openai
VITE_OPENAI_MODEL=gpt-4.1-mini
VITE_GEMINI_MODEL=gemini-2.5-flash
VITE_OPENCODE_MODEL=gpt-4.1-mini
VITE_OPENCODE_BASE_URL=https://api.example.com/v1
