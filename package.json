{
  "name": "handcam-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "oxlint src electron *.js *.ts",
    "preview": "vite preview --host 0.0.0.0",
    "electron": "npm run build && electron electron/main.cjs",
    "clean": "Remove-Item -Recurse -Force dist,node_modules/.vite -ErrorAction SilentlyContinue",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "latest",
    "@types/three": "^0.187.0",
    "peerjs": "^1.5.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.3",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
